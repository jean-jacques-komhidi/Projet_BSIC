# Modele de configuration locale : copiez ce fichier en .env et remplissez-le.
# Le fichier .env n'est jamais publie sur GitHub (voir .gitignore).

# Base PostgreSQL locale (ou DATABASE_URL complete)
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credit_bsic

# Cle de signature des jetons de connexion (longue et aleatoire)
SECRET_KEY=

# Assistant IA (CrediBot)
GROQ_API_KEY=

# Premier administrateur (python -m app.creer_admin)
ADMIN_NOM=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mot de passe des comptes agents de demonstration (python -m app.generer_donnees_test)
MOT_DE_PASSE_AGENTS=
