# ===========================================================================
# .gitignore - Projet_BSIC (racine : backend + frontend)
# ===========================================================================

# --- Environnements virtuels ---
backend/venv/
backend/env/
venv/

# --- Fichiers Python temporaires ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Donnees volumineuses (a ne pas versionner) ---
backend/data/*.csv
backend/notebook/*.csv
*.xlsx

# --- Secrets : NE JAMAIS PUBLIER ---
.env
.env.*
!.env.exemple
backend/.env
backend/logs/

# --- MLflow (artefacts et donnees locales) ---
backend/mlflow/artifacts/
mlruns/

# --- Fichiers de diagnostic temporaires ---
backend/test_connexion.py

# --- Frontend (Node.js / React) ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env

# --- Systeme d'exploitation ---
.DS_Store
Thumbs.db

# --- Editeurs ---
.vscode/
.idea/

# --- Bases de donnees locales et sauvegardes ---
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
*.bak
*_sauvegarde.pkl

# --- Cles, certificats et identifiants ---
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials*.json
secrets/

# --- Journaux et rapports de tests ---
*.log
logs/
.coverage
htmlcov/
mlflow.db
